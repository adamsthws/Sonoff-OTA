#!/bin/sh
# Stops what is staged holding a secret or a real identifier: tools/leak_scan.py
# (docs/technical-details.md#keeping-secrets-out-of-git); then lints it:
# tools/lint.py (docs/testing.md#linters). Installed by
# python3 tools/leak_scan.py install; --no-verify skips it, for what is meant to be there.
root=$(git rev-parse --show-toplevel) || exit 1
python=$root/.venv/bin/python
[ -x "$python" ] || python=python3
"$python" -I "$root/tools/leak_scan.py" staged || exit 1
exec "$python" -I "$root/tools/lint.py" staged
