# Safeboot migration: one-use, explicitly armed canonical-layout commit.
# Loading this file performs no writes. It returns the commit closure.
import flash
import crypto
import string

var base_url = "@BASE_URL@"
var session = "@SESSION@"
var arm_token = "@ARM_TOKEN@"
var armed = true
var source_table_hash = bytes("@SOURCE_TABLE_SHA256@")
var target_table_hash = bytes("@TARGET_TABLE_SHA256@")
var interim_table_hash = bytes("@INTERIM_TABLE_SHA256@")
var live_nvs_hash = bytes("@LIVE_NVS_SHA256@")
var safeboot_hash = bytes("@SAFEBOOT_SHA256@")
var staging_pad_hash = bytes("@STAGING_PAD_SHA256@")
var erased_tail_hash = bytes("@ERASED_TAIL_SHA256@")
var erased_otadata_hash = bytes("@ERASED_OTADATA_SHA256@")
var safeboot_length = @SAFEBOOT_LENGTH@
var copy_length = @SAFEBOOT_COPY_LENGTH@
var staging_pad_length = @STAGING_PAD_LENGTH@
var erased_tail_length = @ERASED_TAIL_LENGTH@
# Sonoff's settings, reserve, boot selection and PHY data: copied to the end
# of ota_0, where the interim table points, before the copy writes over them.
var low_offset = @LOW_REGIONS_OFFSET@
var low_size = @LOW_REGIONS_SIZE@
var moved_low = @MOVED_LOW_OFFSET@

def guard(ok, message)
  if !ok
    raise "migration_refused", message
  end
end

# Tell the computer why this stopped, so it can say so at once instead of
# waiting for a report that is never coming.  One quick try only: if the
# computer cannot be reached, its own timeout says so instead.
def report_failure(exception, message)
  try
    var text = bytes().fromstring(str(exception) + ": " + str(message))
    var reason = bytes()
    var i = 0
    while i < size(text) && i < 200
      var c = text[i]
      if c < 0x20 || c > 0x7E c = 0x3F end
      reason.add(c, 1)
      i += 1
    end
    if tasmota.wifi("up")  # webclient can crash with the Wi-Fi down (Tasmota #18831)
      var client = webclient()
      client.begin(base_url + "/fail/commit")
      client.POST(format("session=%s\nreason=%s\n", session, reason.asstring()))
      client.close()
    else
      print("AUTOFLASH report not sent: the plug's Wi-Fi is down")
    end
  except .. as report_exception, report_message
    print("AUTOFLASH failure report not sent:", report_exception, report_message)
  end
end

def sha_region(address, length)
  var hash = crypto.SHA256()
  var offset = 0
  while offset < length
    var count = length - offset
    if count > 4096 count = 4096 end
    hash.update(flash.read(address + offset, count))
    offset += count
    tasmota.yield()
  end
  return hash.out()
end

# Wait without blocking Wi-Fi reconnects or tripping Berry's timeout.
def pause(ms)
  var wake = tasmota.millis(ms)
  while !tasmota.time_reached(wake)
    tasmota.delay(50)
    tasmota.yield()
  end
end

# How long failed requests are worth trying again: 20 seconds in all, for the
# whole phase.  While a phase runs the plug does nothing else - not even read
# its energy meter, whose readings then pile up until its web server stops
# answering for good, after 70-90 seconds busy (a real S60TPG).  A phase takes
# under a minute, so retrying stops well short of that.  A router restart takes
# longer: this computer runs the step again once the plug is back.
var retry_spent = 0   # ms spent retrying in this phase, all failures together
class retry_window
  var since
  def over()
    if self.since == nil self.since = tasmota.millis() end
    return retry_spent + tasmota.millis() - self.since >= 20000
  end
  def done()   # call after each request's retry loop
    if self.since != nil retry_spent += tasmota.millis() - self.since end
  end
end

# webclient's get_string() waits for ever on a reply that stops part way with
# the connection still open - a router restarting mid-block, say - and the
# plug then answers nothing until it is switched off and on (Tasmota reads a
# body with no time limit: arendst/Tasmota#25139).  So replies are read here
# by hand, and one silent for five seconds is given up, to be asked for again.
# This computer's replies always say how long they are.
var server = string.split(base_url, "/")[2]
var server_ip = string.split(server, ":")[0]
var server_port = int(string.split(server, ":")[1])

# [HTTP status, body]; status -1 when the computer could not be reached, or
# its reply stopped or was cut short.
def get_body(path)
  var client = tcpclient()
  if !client.connect(server_ip, server_port)
    client.close()
    return [-1, nil]
  end
  client.write(format("GET %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n", path, server))
  var reply = ""
  var head = -1
  var length = -1
  var quiet = tasmota.millis(5000)
  while true
    var piece = client.read()
    if size(piece) > 0
      reply += piece
      quiet = tasmota.millis(5000)
      if head < 0
        head = string.find(reply, "\r\n\r\n")
        if head >= 0
          var fields = string.tolower(reply[0 .. head + 1])
          var at = string.find(fields, "\r\ncontent-length:")
          if at < 0 break end
          var i = at + 17
          while fields[i] == " " i += 1 end
          length = int(fields[i .. string.find(fields, "\r", i) - 1])
        end
      end
      if head >= 0 && size(reply) - head - 4 >= length
        client.close()
        return [int(reply[9 .. 11]), reply[head + 4 ..]]
      end
    elif !client.connected() && client.available() == 0
      break  # closed before the whole reply came
    elif tasmota.time_reached(quiet)
      break
    else
      tasmota.delay(5)
      tasmota.yield()
    end
  end
  client.close()
  return [-1, nil]
end

def fetch_table(path, expected_hash, what)
  var reply = [-1, nil]
  var attempt = 0
  var window = retry_window()
  while true
    if tasmota.wifi("up")  # no request with the Wi-Fi down: it can crash Tasmota (#18831)
      reply = get_body(path)
      attempt += 1
      if reply[0] >= 0 break end
    end
    if window.over() break end
    pause(1000)
  end
  window.done()
  # Given up with the Wi-Fi still down: that is the reason, whatever was tried first.
  guard(attempt > 0 && (reply[0] >= 0 || tasmota.wifi("up")),
        "the plug's Wi-Fi went down and was not back within 20 seconds")
  guard(reply[0] == 200, format("%s GET returned HTTP %i after %i attempts", what, reply[0], attempt))
  var encoded = reply[1]
  guard(size(encoded) == 8192, what + " body length differs")
  var table = bytes(encoded)
  guard(size(table) == 4096, what + " hex is invalid")
  guard(crypto.SHA256().update(table).out() == expected_hash,
        "downloaded " + what + " SHA-256 differs")
  return table
end

# Sonoff's low regions to the end of ota_0, each sector read back, then the
# whole compared with what is still in place.
def move_low_regions()
  var wanted = sha_region(low_offset, low_size)
  var offset = 0
  while offset < low_size
    var data = flash.read(low_offset + offset, 0x1000)
    if flash.read(moved_low + offset, 0x1000) != data
      flash.write(moved_low + offset, data)
    end
    guard(flash.read(moved_low + offset, 0x1000) == data,
          format("moved settings read-back differs at 0x%X", moved_low + offset))
    offset += 0x1000
    tasmota.yield()
  end
  guard(sha_region(moved_low, low_size) == wanted, "moved settings differ from the originals")
  guard(sha_region(low_offset, low_size) == wanted, "the settings changed while being moved")
end

# Once the interim table is in place, it is what a restart must find: a
# failure after then leaves it, or puts it back.
def keep_interim_layout(interim)
  try
    if flash.read(0x8000, 0x1000) != interim
      flash.write(0x8000, interim)
    end
    guard(flash.read(0x8000, 0x1000) == interim, "interim table restore differs")
    print("AUTOFLASH ROLLBACK PASS: interim layout kept, with the settings moved aside; safe to restart")
    return true
  except .. as rollback_exception, rollback_message
    print("AUTOFLASH ROLLBACK FAILED; DO NOT REBOOT OR REMOVE POWER:",
          rollback_exception, rollback_message)
    return false
  end
end

def best_effort_report(status, rollback)
  try
    var body = format(
      "session=%s\nstatus=%s\nrollback=%s\ncurrent_ota=%i\n" +
      "target_table_sha256=%s\nsafeboot_sha256=%s\n",
      session, status, str(rollback), flash.current_ota(),
      target_table_hash.tohex(), safeboot_hash.tohex())
    if tasmota.wifi("up")  # webclient can crash with the Wi-Fi down (Tasmota #18831)
      var client = webclient()
      client.begin(base_url + "/report/commit")
      var code = client.POST(body)
      client.close()
      print(format("AUTOFLASH COMMIT report HTTP %i", code))
    else
      print("AUTOFLASH report not sent: the plug's Wi-Fi is down")
    end
  except .. as report_exception, report_message
    print("AUTOFLASH COMMIT report failed:", report_exception, report_message)
  end
end

def restore_source_layout(old_table, old_otadata)
  try
    flash.write(0x1D000, old_otadata)
    guard(flash.read(0x1D000, 0x2000) == old_otadata, "old otadata restore differs")
    flash.write(0x8000, old_table)
    guard(flash.read(0x8000, 0x1000) == old_table, "source table restore differs")
    print("AUTOFLASH ROLLBACK PASS: source table and live old otadata restored; DO NOT REBOOT")
    return true
  except .. as rollback_exception, rollback_message
    print("AUTOFLASH ROLLBACK FAILED; DO NOT REBOOT OR REMOVE POWER:",
          rollback_exception, rollback_message)
    return false
  end
end

def run_commit(provided_token)
  guard(armed, "this commit closure has already been consumed")
  guard(provided_token == arm_token, "arming token differs")
  guard(tasmota.arch() == "esp32c3", "device is not ESP32-C3")
  guard(flash.size() == 0x400000, "flash is not exactly 4 MiB")
  guard(flash.current_ota() == 1, "commit requires old ota_1 to be running")
  guard(sha_region(0x8000, 0x1000) == source_table_hash, "source table changed")
  guard(sha_region(0x9000, 0x5000) == live_nvs_hash, "NVS changed since preflight")
  guard(sha_region(0x20000, safeboot_length) == safeboot_hash,
        "staged Safeboot SHA-256 differs")
  guard(sha_region(0x20000 + safeboot_length, staging_pad_length) == staging_pad_hash,
        "staged Safeboot sector padding is not erased")

  var target_table = fetch_table("/target-table", target_table_hash, "target table")
  var interim = fetch_table("/interim-table", interim_table_hash, "interim table")
  var old_table = flash.read(0x8000, 0x1000)
  var old_otadata = flash.read(0x1D000, 0x2000)
  armed = false
  var interim_in_place = false

  try
    # The copy below writes over Sonoff's settings and boot selection, which
    # a power cut part way would leave the old Tasmota without: moved aside
    # first, with the interim table pointing at them.
    print("AUTOFLASH COMMIT: moving the settings aside")
    move_low_regions()
    flash.write(0x8000, interim)
    guard(flash.read(0x8000, 0x1000) == interim, "interim partition-table read-back differs")
    interim_in_place = true
    print("AUTOFLASH COMMIT: settings moved aside; interim table in place")

    var offset = 0
    var sector = 0
    while offset < copy_length
      # Downward copy is overlap-safe: source is read before its lower destination is erased.
      var data = flash.read(0x20000 + offset, 0x1000)
      flash.write(0x10000 + offset, data)
      guard(flash.read(0x10000 + offset, 0x1000) == data,
            format("canonical Safeboot read-back differs at 0x%X", 0x10000 + offset))
      offset += 0x1000
      sector += 1
      if sector % 16 == 0 print(format("AUTOFLASH COMMIT: copied %i/%i bytes", offset, copy_length)) end
      tasmota.yield()
    end

    guard(sha_region(0x10000, safeboot_length) == safeboot_hash,
          "canonical Safeboot SHA-256 differs")
    guard(sha_region(0x10000 + safeboot_length, staging_pad_length) == staging_pad_hash,
          "canonical Safeboot sector padding differs")

    if erased_tail_length > 0
      flash.erase(0x10000 + copy_length, erased_tail_length)
      guard(sha_region(0x10000 + copy_length, erased_tail_length) == erased_tail_hash,
            "canonical Safeboot erased tail differs")
    end

    # New canonical otadata is erased. Never call flash.factory(): its registry is stale.
    flash.erase(0xE000, 0x2000)
    guard(sha_region(0xE000, 0x2000) == erased_otadata_hash,
          "new canonical otadata did not erase cleanly")

    flash.write(0x8000, target_table)
    guard(flash.read(0x8000, 0x1000) == target_table,
          "official partition-table byte-for-byte read-back differs")
    guard(sha_region(0x8000, 0x1000) == target_table_hash,
          "official partition-table SHA-256 read-back differs")
  except .. as commit_exception, commit_message
    var rollback_ok
    if interim_in_place
      rollback_ok = keep_interim_layout(interim)
    else
      rollback_ok = restore_source_layout(old_table, old_otadata)
    end
    best_effort_report("FAIL", rollback_ok)
    raise commit_exception, commit_message
  end

  print("AUTOFLASH COMMIT PASS: exact official table installed; restarting without settings save")
  best_effort_report("PASS", false)
  tasmota.cmd("Restart 99")
  return true
end

# The closure handed back: commit, reporting any failure before raising it.
def commit(provided_token)
  var result
  try
    result = run_commit(provided_token)
  except .. as commit_exception, commit_message
    report_failure(commit_exception, commit_message)
    raise commit_exception, commit_message
  end
  return result
end

return commit
