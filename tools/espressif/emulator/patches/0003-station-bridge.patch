From: Adam Matthews <52178922+adamsthws@users.noreply.github.com>
Date: Thu, 29 Oct 2026 20:10:56 +0000
Subject: [PATCH 3/7] esp32c3 wifi: real addresses on the wire

The fork rewrote every frame's MAC addresses to its access point's, which
works behind QEMU's NAT (slirp) but not on a real network: Linux dropped the
frames, so the plug never got an address, and the tool could not find it by
MAC. It now bridges the real addresses. It also gives the fork's virtual
station a proper MAC after a cold start (it was all zeros). Offered upstream
as lcgamboa/qemu #14.
---
 hw/misc/esp32_wifi_ap.c | 49 ++++++++++++++++++++++++++++++++++++-----
 1 file changed, 43 insertions(+), 6 deletions(-)

diff --git a/hw/misc/esp32_wifi_ap.c b/hw/misc/esp32_wifi_ap.c
index 5939328..9938938 100644
--- a/hw/misc/esp32_wifi_ap.c
+++ b/hw/misc/esp32_wifi_ap.c
@@ -70,6 +70,24 @@ access_point_info access_points[]={
 
 int nb_aps=sizeof(access_points)/sizeof(access_point_info);
 
+/* Autoflash emulator: the MAC this fork's virtual station uses on the guest's
+ * SoftAP, so the host side of the tap can take it ($ESP32_WIFI_SOFTAP_FILE.station). */
+static void esp32_wifi_report_station(const uint8_t *mac)
+{
+    const char *path = getenv("ESP32_WIFI_SOFTAP_FILE");
+    char name[512];
+    if (!path || snprintf(name, sizeof(name), "%s.station", path) >= (int)sizeof(name)) {
+        return;
+    }
+    FILE *f = fopen(name, "w");
+    if (f) {
+        if (mac) {
+            fprintf(f, "%02x:%02x:%02x:%02x:%02x:%02x", mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+        }
+        fclose(f);
+    }
+}
+
 /* Autoflash emulator: tell the container which network the guest broadcasts as a
  * SoftAP (empty: none), so its stand-in `nmcli` can list it. */
 static void esp32_wifi_report_softap(const char *ssid)
@@ -510,6 +528,10 @@ static ssize_t Esp32_WLAN_receive(NetClientState *ncs,
           return size; 
         }
         Esp32_WLAN_init_ap_frame(s, frame);
+        if (s->mode == Esp32_Mode_Station && s->ap_state == Esp32_WLAN__STATE_ASSOCIATED) {
+            /* Autoflash emulator: from-DS frame, addr3 = the real sender. */
+            memcpy(frame->bssid_address, &buf[6], 6);
+        }
         Esp32_WLAN_insert_frame(s, frame);
     }
     return size;
@@ -526,6 +548,7 @@ static NetClientInfo net_info = {
 
 void Esp32_WLAN_reset_ap(Esp32WifiState *s) {
     esp32_wifi_report_softap(NULL);
+    esp32_wifi_report_station(NULL);
     esp32_wifi_channel = 0;
     s->ap_state = Esp32_WLAN__STATE_NOT_AUTHENTICATED;
     s->beacon_ap=0;
@@ -611,7 +634,15 @@ void Esp32_WLAN_handle_frame(Esp32WifiState *s, struct mac80211_frame *frame)
                 if(s->ap_state==Esp32_WLAN__STATE_NOT_AUTHENTICATED || s->ap_state==Esp32_WLAN__STATE_AUTHENTICATED) {
                     memset(ssid,0,sizeof(ssid));
                     strncpy(ssid,(char *)frame->data_and_fcs+14,MIN(frame->data_and_fcs[13],32));
+                    if (!memcmp(s->ap_macaddr, (uint8_t[6]){0}, 6)) {
+                        /* Autoflash emulator: after a cold start the virtual
+                         * station has no MAC yet; an all-zero one is not a
+                         * usable station address (nor a host interface's). */
+                        memcpy(s->ap_macaddr, (uint8_t[]){0x02,0x53,0x36,0x30,0x00,0x01}, 6);
+                        memcpy(dummy_ap.mac_address, s->ap_macaddr, 6);
+                    }
                     esp32_wifi_report_softap(ssid);
+                    esp32_wifi_report_station(s->ap_macaddr);
                     if(DEBUG) printf("beacon from %s\n",ssid);
                     dummy_ap.ssid=ssid;
                     dummy_ap.channel = esp32_wifi_channel;
@@ -765,14 +796,20 @@ void Esp32_WLAN_handle_frame(Esp32WifiState *s, struct mac80211_frame *frame)
             ethernet_frame[12] = frame->data_and_fcs[6];
             ethernet_frame[13] = frame->data_and_fcs[7];
 
-            // the new originator of the packet is
-            // the access point
-            if(s->ap_state == Esp32_WLAN__STATE_ASSOCIATED)
-                memcpy(&ethernet_frame[6], s->ap_macaddr, 6);
-            else
+            if(s->ap_state == Esp32_WLAN__STATE_ASSOCIATED) {
+                /* Autoflash emulator: bridge, do not NAT. A to-DS frame carries
+                 * addr1 = BSSID, addr2 = sender, addr3 = destination; put the
+                 * real ones on the wire so a tap/bridge network sees the
+                 * plug's own MAC (slirp is happy either way). */
+                memcpy(&ethernet_frame[0], frame->bssid_address, 6);
+                memcpy(&ethernet_frame[6], frame->source_address, 6);
+            } else {
                 memcpy(&ethernet_frame[6], s->macaddr, 6);
+            }
 
-            if (ethernet_frame[12] == 0x08 && ethernet_frame[13] == 0x06) {
+            if (s->ap_state == Esp32_WLAN__STATE_ASSOCIATED) {
+                /* addresses set above */
+            } else if (ethernet_frame[12] == 0x08 && ethernet_frame[13] == 0x06) {
                 // for arp request, we use a broadcast
                 memset(&ethernet_frame[0], 0xff, 6);
             } else {
