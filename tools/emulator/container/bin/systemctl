#!/bin/bash
# Stand-in for systemd's systemctl, just enough for the conversion tool's
# firewall check (`systemctl is-active ufw`). The container runs no systemd;
# ufw's own setting says whether it is on.
if [ "$1" = is-active ] && [ "$2" = ufw ]; then
    if grep -qx 'ENABLED=yes' /etc/ufw/ufw.conf 2>/dev/null; then
        echo active
        exit 0
    fi
    echo inactive
    exit 3
fi
echo "systemctl (Autoflash emulator stand-in): only 'is-active ufw' is supported" >&2
exit 2
