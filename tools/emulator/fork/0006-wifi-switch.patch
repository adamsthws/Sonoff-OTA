From: Adam Matthews <52178922+adamsthws@users.noreply.github.com>
Date: Thu, 29 Oct 2026 20:10:56 +0000
Subject: [PATCH 6/7] esp32c3 wifi: the access points can be switched off, so
 the router can be restarted

The fork's access points live inside QEMU, so blocking traffic outside it
only cuts the plug off from the computer; its Wi-Fi stays up. While the file
$ESP32_WIFI_AP_OFF_FILE exists (`plug router off`), they send no beacons and
answer nothing, and deauthenticate the plug - a few times, and again whenever
it sends data, as a real access point does to a station that is not joined.
The plug sees its Wi-Fi go within a second or two, retries as a real one does
("Connect failed with AP timeout"), and rejoins within seconds of `plug router
on`. The fork's frame builder leaves a frame's destination and signal strength
unset, so both are set here, or the plug drops the frame. Specific to this
project's container, so not offered upstream.
---
 hw/misc/esp32_wifi_ap.c | 64 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 63 insertions(+), 1 deletion(-)

diff --git a/hw/misc/esp32_wifi_ap.c b/hw/misc/esp32_wifi_ap.c
index 9938938..7cfd89a 100644
--- a/hw/misc/esp32_wifi_ap.c
+++ b/hw/misc/esp32_wifi_ap.c
@@ -103,10 +103,64 @@ static void esp32_wifi_report_softap(const char *ssid)
     }
 }
 
+/* Autoflash emulator: the access points can be switched off, as a router is when
+ * it restarts. While the file named by ESP32_WIFI_AP_OFF_FILE exists, they
+ * send no beacons and answer nothing, and a guest station joined to one is
+ * deauthenticated - a few times, as real access points do, in case one is
+ * missed - so its Wi-Fi goes down as it would. */
+static bool esp32_wifi_aps_off(void)
+{
+    const char *path = getenv("ESP32_WIFI_AP_OFF_FILE");
+    return path && access(path, F_OK) == 0;
+}
+
+static void esp32_wifi_send_deauth(Esp32WifiState *s)
+{
+    struct mac80211_frame *frame = Esp32_WLAN_create_deauthentication();
+    int8_t strength = -25;
+    for (int i = 0; i < nb_aps; i++) {
+        if (!memcmp(access_points[i].mac_address, s->associated_ap_macaddr, 6)) {
+            strength = access_points[i].sigstrength;
+        }
+    }
+    /* new_frame() leaves both unset: the guest would drop the frame. */
+    frame->signal_strength = strength;
+    memcpy(frame->destination_address, BROADCAST, 6);
+    memcpy(s->ap_macaddr, s->associated_ap_macaddr, 6);
+    Esp32_WLAN_init_ap_frame(s, frame);
+    Esp32_WLAN_insert_frame(s, frame);
+}
+
 static void Esp32_WLAN_beacon_timer(void *opaque)
 { 
     struct mac80211_frame *frame;
     Esp32WifiState *s = (Esp32WifiState *)opaque;
+    static int deauths_left;
+    static bool was_off;
+    if (esp32_wifi_aps_off() && s->mode == Esp32_Mode_Station) {
+        if (!was_off) {
+            was_off = true;
+            printf("WIFIAP: access points off (ap_state %u)\n", s->ap_state);
+            fflush(stdout);
+        }
+        if (s->ap_state == Esp32_WLAN__STATE_ASSOCIATED ||
+            s->ap_state == Esp32_WLAN__STATE_AUTHENTICATED) {
+            deauths_left = 5;
+            s->ap_state = Esp32_WLAN__STATE_NOT_AUTHENTICATED;
+        }
+        if (deauths_left > 0) {
+            deauths_left--;
+            esp32_wifi_send_deauth(s);
+        }
+        timer_mod(s->beacon_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + BEACON_TIME);
+        return;
+    }
+    if (was_off) {
+        was_off = false;
+        printf("WIFIAP: access points on\n");
+        fflush(stdout);
+    }
+    deauths_left = 0;
