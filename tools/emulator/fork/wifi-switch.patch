+/* S60 emulation: the access points can be switched off, as a router is when
+ * it restarts. While the file named by ESP32_WIFI_AP_OFF_FILE exists, they
+ * send no beacons and answer nothing, and a guest station joined to one is
+ * told it has been disconnected, as a real one going away would. */
+static bool esp32_wifi_aps_off(void)
+{
+    const char *path = getenv("ESP32_WIFI_AP_OFF_FILE");
+    return path && access(path, F_OK) == 0;
+}
