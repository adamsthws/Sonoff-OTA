diff --git a/src/tapnet.py b/src/tapnet.py
new file mode 100644
index 0000000..f27db17
--- /dev/null
+++ b/src/tapnet.py
@@ -0,0 +1,220 @@
+"""The device's Ethernet on a host TAP device, as a real access point bridges it.
+
+src/netstack.py is a network inside the emulator: it is the device's router,
+DHCP server and DNS, and reaches the host only through sockets and port
+forwards. This module is the other choice: every Ethernet frame the device
+sends through the Wi-Fi peer is written to a TAP device on the host, and
+every frame the host writes there is delivered to the device. The device is
+then a station on whatever network that TAP device is part of - a bridge, a
+container's LAN with its own DHCP server - with its own address, reached as
+any other computer on it is, by every protocol.
+
+It answers nothing itself: no ARP, DHCP or DNS. Whatever is on the host's
+side of the TAP device does, as on a real LAN. The TAP device is made by the
+caller (`ip tuntap add dev tap0 mode tap user $USER`), so the emulator needs
+no privileges of its own to open it.
+
+Frames from the host are read on a helper thread and handed to the device
+from tick(), on device time, as src/netstack.py moves its sockets' bytes.
+Linux only.
+"""
+import collections
+import fcntl
+import os
+import select
+import struct
+import threading
+
+TUNSETIFF = 0x400454CA
+IFF_TAP = 0x0002
+IFF_NO_PI = 0x1000
+MAX_FRAME = 65536
+# Frames read from the host and not yet delivered: beyond this the oldest
+# go, as a busy access point drops them, rather than memory growing.
+QUEUE_LIMIT = 512
+
+
+def open_tap(name):
+    """The file descriptor of the existing TAP device `name`."""
+    fd = os.open("/dev/net/tun", os.O_RDWR)
+    try:
+        fcntl.ioctl(fd, TUNSETIFF, struct.pack("16sH", name.encode(), IFF_TAP | IFF_NO_PI))
+    except OSError:
+        os.close(fd)
+        raise
+    return fd
+
+
+class TapNet:
+    """What WifiPeer needs of a network (output, input, tick, link_up,
+    device_reset, close), with the host's TAP device as that network."""
+
+    def __init__(self, name=None, log=None, fd=None):
+        self.log = log or (lambda *a: None)
+        self.name = name
+        self.fd = open_tap(name) if fd is None else fd
+        self.output = None              # callback(eth_frame), set by WifiPeer
+        self.on_frame = None            # callback(direction, frame, now_us), as NetStack's
+        # Kept for WifiPeer, which sets them when it picks its role; the host
+        # side owns every address here.
+        self.gateway = True
+        self.ip = None
+        self.device_mac = None
+        self.link = False
+        self.now_us = 0
+        self.stats = {"to_host": 0, "to_device": 0, "dropped": 0}
+        self._inbox = collections.deque()
+        self._lock = threading.Lock()
+        self._stop_r, self._stop_w = os.pipe()
+        self._thread = threading.Thread(target=self._read, name="tapnet", daemon=True)
+        self._thread.start()
+        if name:
+            self.log("[NET] the device's Ethernet is bridged to the host's %s" % name)
+
+    def _read(self):
+        while True:
+            ready, _, _ = select.select([self.fd, self._stop_r], [], [])
+            if self._stop_r in ready:
+                return
+            try:
+                frame = os.read(self.fd, MAX_FRAME)
+            except OSError:
+                return
+            if not frame:
+                return
+            with self._lock:
+                if len(self._inbox) >= QUEUE_LIMIT:
+                    self._inbox.popleft()
+                    self.stats["dropped"] += 1
+                self._inbox.append(frame)
+
+    def _trace(self, direction, frame):
+        if self.on_frame is None:
+            return
+        try:
+            self.on_frame(direction, bytes(frame), self.now_us)
+        except Exception:
+            pass                            # a front end must never break the run
+
+    def input(self, frame):
+        """A frame from the device: onto the host's network."""
+        if len(frame) < 14:
+            return
+        self._trace("from device", frame)
+        try:
+            os.write(self.fd, frame)
+            self.stats["to_host"] += 1
+        except OSError as e:
+            # The TAP device down (no one has it up yet): the frame is lost,
+            # as on a cable not plugged in.
+            self.stats["dropped"] += 1
+            self.log("[NET] %s: frame not written (%s)" % (self.name or "tap", e))
+
+    def tick(self, now_us):
+        self.now_us = now_us
+        with self._lock:
+            frames = list(self._inbox)
+            self._inbox.clear()
+        for frame in frames:
+            if self.output is None:
+                break
+            self._trace("to device", frame)
+            self.output(frame)
+            self.stats["to_device"] += 1
+
+    def link_up(self, device_mac=None):
+        if device_mac:
+            self.device_mac = device_mac
+        self.link = True
+
+    def device_reset(self, now_us):
+        """The device rebooted: what the host sent its old boot is dropped.
+        The host's network, like a real one, carries on."""
+        self.now_us = now_us
+        with self._lock:
+            self._inbox.clear()
+        self.link = False
+        self.device_mac = None
+
+    def summary(self):
+        return {"tap": self.name, **self.stats}
+
+    def close(self):
+        if self._stop_w is None:
+            return
+        os.write(self._stop_w, b"x")
+        self._thread.join(2.0)
+        for fd in (self._stop_r, self._stop_w, self.fd):
+            try:
+                os.close(fd)
+            except OSError:
+                pass
+        self._stop_w = None
+        self.output = None
+        self.on_frame = None
+
+
+# ---------------------------------------------------------------------------
+# Self-tests. Run: python src/tapnet.py
+# ---------------------------------------------------------------------------
+def _run_selftests():
+    import socket
+    import time
+
+    n = 0
+
+    def check(cond, msg):
+        nonlocal n
+        assert cond, "FAIL: " + msg
+        n += 1
+        print("  [PASS]", msg)
+
+    # A datagram socket pair keeps frame boundaries as a TAP device does, so
+    # the bridge is tested without the privileges making one takes.
+    host, mine = socket.socketpair(socket.AF_UNIX, socket.SOCK_DGRAM)
+    logs, to_device = [], []
+    net = TapNet(log=logs.append, fd=os.dup(mine.fileno()))
+    mine.close()
+    net.output = to_device.append
+    traced = []
+    net.on_frame = lambda d, f, us: traced.append(d)
+
+    frame = bytes.fromhex("ffffffffffff" "c8478c000001" "0806") + bytes(28)
+    net.input(frame)
+    check(host.recv(MAX_FRAME) == frame, "a frame from the device reaches the host unchanged")
+    net.input(b"short")
+    check(net.stats["to_host"] == 1, "a runt frame is not passed on")
+
+    reply = bytes.fromhex("c8478c000001" "020000000099" "0800") + b"\x45" + bytes(40)
+    host.send(reply)
+    for _ in range(100):
+        net.tick(1000)
+        if to_device:
+            break
+        time.sleep(0.01)
+    check(to_device == [reply], "a frame from the host is delivered to the device on tick()")
+    check(traced == ["from device", "to device"], "both directions are traced, as NetStack's are")
+
+    host.send(reply)
+    time.sleep(0.1)
+    net.device_reset(2000)
+    net.tick(3000)
+    check(to_device == [reply], "frames waiting at a device reset are dropped, not sent to the new boot")
+
+    for i in range(QUEUE_LIMIT + 5):
+        host.send(reply[:-1] + bytes([i & 0xFF]))
+    time.sleep(0.3)
+    to_device.clear()
+    net.tick(4000)
+    check(len(to_device) == QUEUE_LIMIT and net.stats["dropped"] == 5,
+          "a flood from the host is bounded: the oldest frames are dropped")
+
+    net.close()
+    net.close()
+    check(not net._thread.is_alive(), "close() stops the reader, and twice is harmless")
+    host.close()
+    print("tapnet: %d checks passed" % n)
+
+
+if __name__ == "__main__":
+    _run_selftests()
diff --git a/tests/tapnet.py b/tests/tapnet.py
new file mode 100644
index 0000000..75c4d5a
--- /dev/null
+++ b/tests/tapnet.py
@@ -0,0 +1,91 @@
+"""The Wi-Fi peer bridged to a host TAP device (src/tapnet.py)."""
+
+import os
+import socket
+import sys
+import time
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from src.emulator import BekenEmulator
+from src import tapnet, wifipeer
+
+
+def make_emulator():
+    emu = BekenEmulator(b"\xff" * 0x20000, None, b"", only_uart=True, wifi=True)
+    emu.setup()
+    return emu
+
+
+def test_station_traffic_crosses_the_bridge():
+    # A datagram socket pair stands in for the TAP device, which takes
+    # privileges to make; it keeps frame boundaries as one does.
+    host, mine = socket.socketpair(socket.AF_UNIX, socket.SOCK_DGRAM)
+    real_open = tapnet.open_tap
+    tapnet.open_tap = lambda name: os.dup(mine.fileno())
+    emu = make_emulator()
+    try:
+        peer = emu.attach_wifi_peer(role="ap", ssid="HomeNet", tap="tap0")
+        assert isinstance(peer.net, tapnet.TapNet)
+        peer.latency_us = 0
+        delivered = []
+        # Data frames only: the access point beacons on its own ticks too.
+        peer.inject = lambda f, decr=None: delivered.append(f) if f[0] & 0x0C == 0x08 else None
+        device = bytes.fromhex("c8478c000001")
+        peer.stations[device] = {"state": "ASSOC", "aid": 1}
+
+        # The device's DHCP discover, as a to-DS data frame: on the host's
+        # network unchanged, for the host's DHCP server to answer.
+        ether = b"\x08\x00" + b"\x45" + bytes(40)
+        frame = peer._data(b"\xff" * 6, device, peer.ap_bssid, wifipeer.LLC_SNAP + ether, to_ds=True)
+        peer.on_device_tx(frame)
+        assert host.recv(65536) == b"\xff" * 6 + device + ether
+
+        # The host's reply, delivered to the device as a from-DS frame.
+        host.send(device + bytes.fromhex("020000000099") + ether)
+        for _ in range(100):
+            peer.tick()
+            if delivered:
+                break
+            time.sleep(0.01)
+        assert len(delivered) == 1 and delivered[0][4:10] == device
+        assert delivered[0].endswith(wifipeer.LLC_SNAP + ether)
+    finally:
+        tapnet.open_tap = real_open
+        emu.close_network()
+        host.close()
+        mine.close()
+
+
+def test_built_in_network_options_are_refused():
+    emu = make_emulator()
+    try:
+        emu.attach_wifi_peer(role="ap", tap="tap0", forwards=((8080, 80),))
+    except ValueError as e:
+        assert "port forwards" in str(e)
+    else:
+        raise AssertionError("a TAP device with port forwards was accepted")
+
+
+def test_a_missing_tap_device_is_a_plain_error():
+    emu = make_emulator()
+    try:
+        emu.attach_wifi_peer(role="ap", tap="no-such-tap-device")
+    except ValueError as e:
+        assert "cannot open the TAP device no-such-tap-device" in str(e)
+    else:
+        raise AssertionError("a TAP device that cannot be opened was accepted")
+
+
+def main():
+    test_station_traffic_crosses_the_bridge()
+    test_built_in_network_options_are_refused()
+    test_a_missing_tap_device_is_a_plain_error()
+    print("TAP bridge self-tests passed.")
+
+
+if __name__ == "__main__":
+    main()
