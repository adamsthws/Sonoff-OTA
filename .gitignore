# Private per-device material. Never commit this directory.
captures/

# Local Python and PlatformIO environments/downloads.
.pio-home/
.platformio/
.platformio-core/
.python-venv/
.venv/
# The start scripts' portable Python, and the record of one they installed.
.python/
.pio/
bridge/.pio/

# Generated build configuration and caches.
sdkconfig.*
# The unit tests' coverage (python -m coverage run).
.coverage
# Generated configs stay out; the bridge's chosen settings must not.
!sdkconfig.defaults
__pycache__/
*.py[cod]
*.elf

# Firmware is excluded by default. These reviewed public artifacts are
# intentionally versioned so a clone is usable.
*.bin
*.bin.*
*.img
*.ota
!artifacts/autoflash-bridge-sonoff-s60-4.4.4.ota
!artifacts/tasmota-settings-template-15.6.0.0.bin
!artifacts/autoflash-recovery-safeboot-imprintable.bin
!artifacts/tasmota32c3-bluetooth.bin
!artifacts/esphome-sonoff-s60-bootloader-1.2.0.bin
!artifacts/esphome-sonoff-s60-imprintable-1.3.0.bin
!artifacts/autoflash-mover-1.1.0.bin
!artifacts/sonoff-s60-partition-table.bin

# Answers for unattended runs: the eWeLink password, perhaps sudo's (see .env.example).
.env

# Local authorization markers must never replace the shipped safety lock.
RECOVERY_LOCK.owner-authorized*
REPARTITION_LOCK.owner-authorized*

# Accidental/temporary files from development.
0
*.bak

# tools/leak_scan.py: your own values to keep out of Git.
.leak-scan.local
