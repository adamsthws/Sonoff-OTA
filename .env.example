# Answers given in advance, for a conversion nobody sits through:
#
#     python3 tools/unattended_run.py      recorded, the final screen shown at the end
#     sh start.sh run --unattended          the same, unrecorded
#
# Copy this file to .env (which git ignores), fill it in, and keep it to
# yourself:  chmod 600 .env
# Names set in the environment win over the file.

# The eWeLink account the plug is in.
EWELINK_EMAIL=
EWELINK_PASSWORD=

# Linux and macOS: this computer's password, only where sudo asks for one -
# the run adds, then removes, a firewall rule letting the plug fetch firmware
# from this computer. Leave it empty if sudo does not ask. (Windows asks in
# its own UAC window instead, which still needs a click.)
S60_SUDO_PASSWORD=

# Only for converting a plug from an ESPHome that cannot say its Wi-Fi
# password (one older than this project's 1.1.0, or whose API has an
# encryption key) when this computer has no Sonoff backup of the plug to take
# it from: the 2.4 GHz network it is on, and its password (leave the password
# out for an open network). From any other firmware the run reads them off
# the plug itself.
S60_WIFI_SSID=
S60_WIFI_PASSWORD=

# Only for a plug with a password on its firmware: Tasmota's web password
# (its user is admin), or ESPHome's update password (password: under ota: in
# its config). Without it a run asks for it, or, unattended, stops there.
S60_TASMOTA_PASSWORD=
S60_ESPHOME_OTA_PASSWORD=
