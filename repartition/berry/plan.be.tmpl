# The plan: what this computer has planned for the plug to write, carried out
# here and checked as it goes (tools/autoflash/plans.py says what each plan
# is).  First the plug checks it is laid out as the plan expects and runs from
# the slot it expects; then each step, in order:
# - write, streamed: one 4 KiB block at a time - fetched, written unless it is
#   already right (so a plan run again rewrites nothing it finished), read back,
#   and the read-back sent to this computer to be compared byte for byte;
# - write, whole (a bootloader, a partition table, the boot selection): all of
#   it fetched and checked before its first byte is written, so nothing waits
#   on the network while the plug cannot start, then written a sector at a
#   time, each read back at once, and the old bytes put back if one differs;
# - erase: a region cleared, unless it already is, and checked;
# - copy: bytes already on the plug moved elsewhere on it, each sector read
#   back, then the whole compared with where it came from.
# Then the report, and a restart if the plan has one.
import flash
import crypto
import string

var base_url = "@BASE_URL@"
var session = "@SESSION@"
var plan_name = "@PLAN_NAME@"
var expected_table = bytes("@TABLE_SHA256@")
var final_table = bytes("@FINAL_TABLE_SHA256@")
var expected_running = @RUNNING@
var restart_after = @RESTART@
var steps = @STEPS@

def guard(ok, message)
  if !ok
    raise "migration_refused", message
  end
end

# Tell the computer why this stopped, so it can say so at once instead of
# waiting for a report that is never coming.  One quick try only: if the
# computer cannot be reached, its own timeout says so instead.
def report_failure(exception, message)
  try
    var text = bytes().fromstring(str(exception) + ": " + str(message))
    var reason = bytes()
    var i = 0
    while i < size(text) && i < 200
      var c = text[i]
      if c < 0x20 || c > 0x7E c = 0x3F end
      reason.add(c, 1)
      i += 1
    end
    if tasmota.wifi("up")  # webclient can crash with the Wi-Fi down (Tasmota #18831)
      var client = webclient()
      client.begin(base_url + "/fail/plan")
      client.POST(format("session=%s\nreason=%s\n", session, reason.asstring()))
      client.close()
    else
      print("AUTOFLASH report not sent: the plug's Wi-Fi is down")
    end
  except .. as report_exception, report_message
    print("AUTOFLASH failure report not sent:", report_exception, report_message)
  end
end

def sha_region(address, length)
  var hash = crypto.SHA256()
  var offset = 0
  while offset < length
    var count = length - offset
    if count > 4096 count = 4096 end
    hash.update(flash.read(address + offset, count))
    offset += count
    tasmota.yield()
  end
  return hash.out()
end

# Wait without blocking Wi-Fi reconnects or tripping Berry's timeout.
def pause(ms)
  var wake = tasmota.millis(ms)
  while !tasmota.time_reached(wake)
    tasmota.delay(50)
    tasmota.yield()
  end
end

# How long failed requests are worth trying again: 20 seconds in all, for the
# whole phase.  While a phase runs the plug does nothing else - not even read
# its energy meter, whose readings then pile up until its web server stops
# answering for good, after 70-90 seconds busy (a real S60TPG).  A phase takes
# under a minute, so retrying stops well short of that.  A router restart takes
# longer: this computer runs the step again once the plug is back.
var retry_until = nil
class retry_window
  def over()
    if retry_until == nil retry_until = tasmota.millis(20000) end
    return tasmota.time_reached(retry_until)
  end
end

# webclient's get_string() waits for ever on a reply that stops part way with
# the connection still open - a router restarting mid-block, say - and the
# plug then answers nothing until it is switched off and on (Tasmota reads a
# body with no time limit: arendst/Tasmota#25139).  So replies are read here
# by hand, and one silent for five seconds is given up, to be asked for again.
# This computer's replies always say how long they are.
var server = string.split(base_url, "/")[2]
var server_ip = string.split(server, ":")[0]
var server_port = int(string.split(server, ":")[1])

# [HTTP status, body]; status -1 when the computer could not be reached, or
# its reply stopped or was cut short.
def get_body(path)
  var client = tcpclient()
  if !client.connect(server_ip, server_port)
    client.close()
    return [-1, nil]
  end
  client.write(format("GET %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n", path, server))
  var reply = ""
  var head = -1
  var length = -1
  var quiet = tasmota.millis(5000)
  while true
    var piece = client.read()
    if size(piece) > 0
      reply += piece
      quiet = tasmota.millis(5000)
      if head < 0
        head = string.find(reply, "\r\n\r\n")
        if head >= 0
          var fields = string.tolower(reply[0 .. head + 1])
          var at = string.find(fields, "\r\ncontent-length:")
          if at < 0 break end
          var i = at + 17
          while fields[i] == " " i += 1 end
          length = int(fields[i .. string.find(fields, "\r", i) - 1])
        end
      end
      if head >= 0 && size(reply) - head - 4 >= length
        client.close()
        return [int(reply[9 .. 11]), reply[head + 4 ..]]
      end
    elif !client.connected() && client.available() == 0
      break  # closed before the whole reply came
    elif tasmota.time_reached(quiet)
      break
    else
      tasmota.delay(5)
      tasmota.yield()
    end
  end
  client.close()
  return [-1, nil]
end

def post_text(path, body)
  var status = -1
  var attempt = 0
  var window = retry_window()
  while true
    if tasmota.wifi("up")  # webclient can crash with the Wi-Fi down (Tasmota #18831)
      var client = webclient()
      client.begin(base_url + path)
      status = client.POST(body)
      client.close()
      attempt += 1
      if status >= 0 break end
    end
    if window.over() break end
    pause(1000)
  end
  # Given up with the Wi-Fi still down: that is the reason, whatever was tried first.
  guard(attempt > 0 && (status >= 0 || tasmota.wifi("up")),
        "the plug's Wi-Fi went down and was not back within 20 seconds")
  guard(status == 200, format("POST %s returned HTTP %i after %i attempts", path, status, attempt))
end

def fetch_chunk(kind, index, expected_length)
  var path = format("/chunk/%s/%i", kind, index)
  var reply = [-1, nil]
  var attempt = 0
  var window = retry_window()
  while true
    if tasmota.wifi("up")  # no request with the Wi-Fi down: it can crash Tasmota (#18831)
      reply = get_body(path)
      attempt += 1
      if reply[0] >= 0 break end
    end
    if window.over() break end
    pause(1000)
  end
  # Given up with the Wi-Fi still down: that is the reason, whatever was tried first.
  guard(attempt > 0 && (reply[0] >= 0 || tasmota.wifi("up")),
        "the plug's Wi-Fi went down and was not back within 20 seconds")
  guard(reply[0] == 200, format("GET %s returned HTTP %i after %i attempts", path, reply[0], attempt))
  var encoded = reply[1]
  guard(size(encoded) == expected_length * 2, kind + " chunk body length differs")
  var data = bytes(encoded)
  guard(size(data) == expected_length, kind + " chunk hex is invalid")
  return data
end


# A streamed write, block by block.  The last block, when it is short, is
# compared and written with the rest of its sector erased, so what follows
# the data reads erased - also when a run before left something there.
def write_streamed(step)
  var address = step["addr"]
  var total = step["len"]
  var offset = 0
  var index = step["first"]
  while offset < total
    var count = total - offset
    if count > 4096 count = 4096 end
    var data = fetch_chunk(step["blob"], index, count)
    var wanted = data
    if count < 4096
      wanted = data.copy()
      while size(wanted) < 4096 wanted.add(0xFF, 1) end
    end
    if flash.read(address + offset, size(wanted)) != wanted
      if count < 4096 flash.erase(address + offset, 0x1000) end
      flash.write(address + offset, data)
    end
    var readback = flash.read(address + offset, count)
    guard(readback == data, format("read-back differs at 0x%X", address + offset))
    post_text(format("/capture/%s/%i", step["blob"], index), readback.tohex())
    offset += count
    index += 1
    if index % 16 == 0 print(format("AUTOFLASH PLAN: %s %i/%i bytes", step["blob"], offset, total)) end
    tasmota.yield()
  end
end

# A whole write: all of it first, then sector by sector, the old bytes kept
# to put back.
def write_whole(step)
  var address = step["addr"]
  var total = step["len"]
  var wanted = bytes()
  var index = step["first"]
  while size(wanted) < total
    var count = total - size(wanted)
    if count > 4096 count = 4096 end
    wanted += fetch_chunk(step["blob"], index, count)
    index += 1
  end
  var hash = crypto.SHA256()
  hash.update(wanted)
  guard(hash.out() == bytes(step["sha"]), step["blob"] + " SHA-256 differs")
  while size(wanted) % 4096 != 0 wanted.add(0xFF, 1) end
  var room = size(wanted)

  var before = flash.read(address, room)
  if before != wanted
    var good = true
    var at = 0
    while at < room
      var sector = wanted[at .. at + 4095]
      flash.write(address + at, sector)
      if flash.read(address + at, 4096) != sector
        good = false
        break
      end
      at += 4096
    end
    if !good
      flash.write(address, before)
      guard(flash.read(address, room) == before,
            step["blob"] + " did not write correctly and the old bytes could not be put back")
      guard(false, step["blob"] + " did not write correctly; the old bytes were put back")
    end
    print("AUTOFLASH PLAN: " + step["blob"] + " written and read back")
  else
    print("AUTOFLASH PLAN: " + step["blob"] + " already in place")
  end
  var offset = 0
  index = step["first"]
  while offset < total
    var count = total - offset
    if count > 4096 count = 4096 end
    post_text(format("/capture/%s/%i", step["blob"], index), flash.read(address + offset, count).tohex())
    offset += count
    index += 1
  end
end

# A copy from one place on the plug to another: what this computer does not
# have, such as the plug's settings.
def copy_region(step)
  var source = step["src"]
  var address = step["addr"]
  var total = step["len"]
  var wanted = sha_region(source, total)
  if sha_region(address, total) != wanted
    var offset = 0
    while offset < total
      var data = flash.read(source + offset, 0x1000)
      if flash.read(address + offset, 0x1000) != data
        flash.write(address + offset, data)
      end
      guard(flash.read(address + offset, 0x1000) == data,
            format("copy read-back differs at 0x%X", address + offset))
      offset += 0x1000
      tasmota.yield()
    end
  end
  guard(sha_region(address, total) == wanted, format("the copy to 0x%X differs from its source", address))
  guard(sha_region(source, total) == wanted, format("0x%X changed while being copied", source))
  print(format("AUTOFLASH PLAN: 0x%X copied to 0x%X", source, address))
end

def run_plan()
  guard(tasmota.arch() == "esp32c3", "device is not ESP32-C3")
  guard(flash.size() == 0x400000, "flash is not exactly 4 MiB")
  var table = sha_region(0x8000, 0x1000)
  # A plan that writes the table, run again after it did, finds the new one.
  guard(table == expected_table || table == final_table,
        "the partition table is not the one this plan is for")
  if expected_running != nil
    guard(flash.current_ota() == expected_running,
          format("the plug runs from slot %i, not %i", flash.current_ota(), expected_running))
  end

  # Run again after its table was written, the plan's copies are done - and
  # the plug may have saved over them since, which copying again would undo.
  var table_written = table == final_table && final_table != expected_table

  var report = format("session=%s\nstatus=PASS\nplan=%s\n", session, plan_name)
  var i = 0
  while i < size(steps)
    var step = steps[i]
    if step["op"] == "erase"
      if sha_region(step["addr"], step["len"]) != bytes(step["sha"])
        flash.erase(step["addr"], step["len"])
      end
      guard(sha_region(step["addr"], step["len"]) == bytes(step["sha"]),
            format("0x%X did not erase", step["addr"]))
      report += format("step%i=erased\n", i)
    elif step["op"] == "copy"
      if !table_written copy_region(step) end
      report += format("step%i=copied\n", i)
    else
      if step["whole"] write_whole(step) else write_streamed(step) end
      var written = sha_region(step["addr"], step["len"])
      guard(written == bytes(step["sha"]), step["blob"] + " as written differs")
      if step["pad"] > 0
        guard(sha_region(step["addr"] + step["len"], step["pad"]) == bytes(step["padsha"]),
              "the sector after " + step["blob"] + " is not erased")
      end
      report += format("step%i=%s\n", i, written.tohex())
    end
    i += 1
  end
  guard(sha_region(0x8000, 0x1000) == final_table, "the partition table is not as planned")

  post_text("/report/plan", report)
  if restart_after
    print("AUTOFLASH PLAN PASS; restarting")
    tasmota.cmd("Restart 99")
  else
    print("AUTOFLASH PLAN PASS")
  end
  return true
end

var result
try
  result = run_plan()
except .. as plan_exception, plan_message
  report_failure(plan_exception, plan_message)
  raise plan_exception, plan_message
end
return result
