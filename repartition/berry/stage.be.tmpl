# S60 Safeboot migration: stage official Safeboot in inactive old ota_0.
# This phase does not change the partition table or boot selection.
import flash
import crypto

var base_url = "@BASE_URL@"
var session = "@SESSION@"
var expected_table = bytes("@SOURCE_TABLE_SHA256@")
var expected_nvs = bytes("@LIVE_NVS_SHA256@")
var expected_safeboot = bytes("@SAFEBOOT_SHA256@")
var staging_pad_hash = bytes("@STAGING_PAD_SHA256@")
var safeboot_length = @SAFEBOOT_LENGTH@
var staging_pad_length = @STAGING_PAD_LENGTH@
var stage_address = 0x20000

def guard(ok, message)
  if !ok
    raise "migration_refused", message
  end
end

# Tell the computer why this stopped, so it can say so at once instead of
# waiting for a report that is never coming.  One quick try only: if the
# computer cannot be reached, its own timeout says so instead.
def report_failure(exception, message)
  try
    var text = bytes().fromstring(str(exception) + ": " + str(message))
    var reason = bytes()
    var i = 0
    while i < size(text) && i < 200
      var c = text[i]
      if c < 0x20 || c > 0x7E c = 0x3F end
      reason.add(c, 1)
      i += 1
    end
    if tasmota.wifi("up")  # webclient can crash with the Wi-Fi down (Tasmota #18831)
      var client = webclient()
      client.begin(base_url + "/fail/stage")
      client.POST(format("session=%s\nreason=%s\n", session, reason.asstring()))
      client.close()
    else
      print("S60 report not sent: the plug's Wi-Fi is down")
    end
  except .. as report_exception, report_message
    print("S60 failure report not sent:", report_exception, report_message)
  end
end

def sha_region(address, length)
  var hash = crypto.SHA256()
  var offset = 0
  while offset < length
    var count = length - offset
    if count > 4096 count = 4096 end
    hash.update(flash.read(address + offset, count))
    offset += count
    tasmota.yield()
  end
  return hash.out()
end

# Wait without blocking Wi-Fi reconnects or tripping Berry's timeout.
def pause(ms)
  var wake = tasmota.millis(ms)
  while !tasmota.time_reached(wake)
    tasmota.delay(50)
    tasmota.yield()
  end
end

# How long a failed request is worth trying again.  Up to five minutes while
# the plug's Wi-Fi is down - a router restarting, say.  One minute while it is
# up and the computer still does not answer: the computer has most likely
# stopped, and while the plug keeps trying it answers nothing else.
class retry_window
  var deadline, up_deadline
  def init()
    self.deadline = tasmota.millis(300000)
    self.up_deadline = nil
  end
  def over()
    if tasmota.time_reached(self.deadline) return true end
    if tasmota.wifi("up")
      if self.up_deadline == nil self.up_deadline = tasmota.millis(60000) end
      return tasmota.time_reached(self.up_deadline)
    end
    self.up_deadline = nil
    return false
  end
end

def post_text(path, body)
  var status = -1
  var attempt = 0
  var window = retry_window()
  while true
    if tasmota.wifi("up")  # webclient can crash with the Wi-Fi down (Tasmota #18831)
      var client = webclient()
      client.begin(base_url + path)
      status = client.POST(body)
      client.close()
      attempt += 1
      if status >= 0 break end
    end
    if window.over() break end
    pause(1000)
  end
  # Given up with the Wi-Fi still down: that is the reason, whatever was tried first.
  guard(attempt > 0 && (status >= 0 || tasmota.wifi("up")),
        "the plug's Wi-Fi went down and did not come back within five minutes")
  guard(status == 200, format("POST %s returned HTTP %i after %i attempts", path, status, attempt))
end

def fetch_chunk(index, expected_length)
  var path = format("/chunk/safeboot/%i", index)
  var client
  var status = -1
  var attempt = 0
  var window = retry_window()
  while true
    if tasmota.wifi("up")  # webclient can crash with the Wi-Fi down (Tasmota #18831)
      client = webclient()
      client.begin(base_url + path)
      status = client.GET()
      attempt += 1
      if status >= 0 break end
      client.close()
    end
    if window.over() break end
    pause(1000)
  end
  # Given up with the Wi-Fi still down: that is the reason, whatever was tried first.
  guard(attempt > 0 && (status >= 0 || tasmota.wifi("up")),
        "the plug's Wi-Fi went down and did not come back within five minutes")
  if status != 200 client.close() end
  guard(status == 200, format("GET %s returned HTTP %i after %i attempts", path, status, attempt))
  guard(client.get_size() == expected_length * 2, "Safeboot chunk HTTP length differs")
  var encoded = client.get_string()
  client.close()
  guard(size(encoded) == expected_length * 2, "Safeboot chunk body length differs")
  var data = bytes(encoded)
  guard(size(data) == expected_length, "Safeboot chunk hex is invalid")
  return data
end

def run_stage()
  guard(tasmota.arch() == "esp32c3", "device is not ESP32-C3")
  guard(flash.size() == 0x400000, "flash is not exactly 4 MiB")
  guard(flash.current_ota() == 1, "refusing to overwrite the running old ota_0")
  guard(sha_region(0x8000, 0x1000) == expected_table, "source table changed")
  guard(sha_region(0x9000, 0x5000) == expected_nvs, "NVS changed since preflight")
  guard(stage_address + safeboot_length <= 0x210000, "Safeboot exceeds inactive slot")

  var offset = 0
  var index = 0
  while offset < safeboot_length
    var count = safeboot_length - offset
    if count > 4096 count = 4096 end
    var data = fetch_chunk(index, count)
    # flash.write preserves untouched bytes during a partial-sector write.
    # Erase the final sector first so the bytes after the image remain 0xFF.
    if count < 4096 flash.erase(stage_address + offset, 0x1000) end
    flash.write(stage_address + offset, data)
    var readback = flash.read(stage_address + offset, count)
    guard(readback == data, format("read-back differs at 0x%X", stage_address + offset))
    post_text(format("/capture/staged/%i", index), readback.tohex())
    offset += count
    index += 1
    if index % 16 == 0 print(format("S60 STAGE: %i/%i bytes", offset, safeboot_length)) end
    tasmota.yield()
  end

  var staged_hash = sha_region(stage_address, safeboot_length)
  guard(staged_hash == expected_safeboot, "complete staged Safeboot SHA-256 differs")
  if staging_pad_length > 0
    guard(sha_region(stage_address + safeboot_length, staging_pad_length) == staging_pad_hash,
          "staged Safeboot sector padding is not erased")
  end
  guard(sha_region(0x8000, 0x1000) == expected_table, "source table changed during staging")
  guard(sha_region(0x9000, 0x5000) == expected_nvs, "NVS changed during staging")

  var report = format(
    "session=%s\nstatus=PASS\ncurrent_ota=%i\ntable_sha256=%s\n" +
    "nvs_sha256=%s\nstaged_sha256=%s\nstaged_size=%i\n",
    session, flash.current_ota(), expected_table.tohex(), expected_nvs.tohex(),
    staged_hash.tohex(), safeboot_length)
  post_text("/report/stage", report)
  print("S60 SAFEBOOT STAGE PASS; table and boot selection are unchanged")
  return true
end

var result
try
  result = run_stage()
except .. as stage_exception, stage_message
  report_failure(stage_exception, stage_message)
  raise stage_exception, stage_message
end
return result
